# Public base URL used in invitation and reset links
APP_BASE_URL=http://localhost:4321

DATABASE_URL=postgres://course:course@localhost:5442/course

# SMTP (Mailpit in development)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Czechitas Course Terminal <kurz@example.com>"
# Optional: send through the Brevo HTTP API instead of SMTP (hosts that block SMTP, e.g. Railway Hobby).
# SMTP_FROM stays the sender; SMTP_HOST/SMTP_PORT are then ignored.
# BREVO_API_KEY=

# Content source: a git repository URL or local path, and the branch to publish
CONTENT_REPO_URL=../czechitas-agentic-programming-content
CONTENT_BRANCH=main
# Optional preview mode for authors: show content straight from this directory, skipping
# "Aktualizovat obsah". Never set in production.
# CONTENT_DIR=../czechitas-agentic-programming-content

# Behind a reverse proxy (production): trust X-Forwarded-For for client addresses
TRUST_PROXY=false

# Support contact shown in emails; owner of content maintenance
SUPPORT_EMAIL=podpora@example.com

# Policy values — proposed defaults, to be confirmed (see docs/decisions.md)
INVITATION_TTL_HOURS=168
PASSWORD_RESET_TTL_MINUTES=60
SESSION_TTL_DAYS=30
