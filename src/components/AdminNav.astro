---
const path = Astro.url.pathname;
const links = [
  { href: '/admin/uzivatele', label: 'Uživatelé' },
  { href: '/admin/odpovedi', label: 'Odpovědi' },
  { href: '/admin/obsah', label: 'Obsah' },
];
---

<nav class="admin-nav" aria-label="Administrace">
  <ul role="list">
    {
      links.map((link) => (
        <li>
          <a href={link.href} aria-current={path.startsWith(link.href) ? 'page' : undefined}>
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
