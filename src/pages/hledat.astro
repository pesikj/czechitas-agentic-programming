---
import CourseLayout from '../layouts/CourseLayout.astro';
import { otherContext } from '../lib/navigation';
import { getContent, searchContent } from '../server/content/provider';
import { czechCount } from '../server/format';

const query = (Astro.url.searchParams.get('q') ?? '').trim().slice(0, 200);
const hits = query ? await searchContent(query) : [];
const { model } = await getContent();
---

<CourseLayout title={query ? `Hledání: ${query}` : 'Hledání'} courseTitle={model?.title} model={model} context={otherContext(model)} crumbs={[{ label: 'hledat' }]}>
  <div class="search-page">
    <h1>Hledání v materiálech</h1>
    <form method="get" role="search" class="search-form">
      <label for="search-q" class="visually-hidden">Hledaný výraz</label>
      <input id="search-q" name="q" type="search" value={query} placeholder="např. prompt, terminál" />
      <button type="submit">Hledat</button>
    </form>
    {
      query && (
        <p role="status">
          {hits.length === 0
            ? `Výrazu „${query}“ neodpovídá žádná část. Zkuste jiné nebo kratší slovo.`
            : `${czechCount(hits.length, 'nalezená část', 'nalezené části', 'nalezených částí')} pro „${query}“.`}
        </p>
      )
    }
    {
      hits.length > 0 && (
        <ol class="search-results" role="list">
          {hits.map((hit) => (
            <li>
              <a href={hit.href}>{hit.partTitle}</a>
              <span class="where">
                {hit.lectureTitle} · část {hit.partNumber}
              </span>
              <p class="snippet">
                {hit.snippet.before}
                {hit.snippet.match && <mark>{hit.snippet.match}</mark>}
                {hit.snippet.after}
              </p>
            </li>
          ))}
        </ol>
      )
    }
  </div>
</CourseLayout>
